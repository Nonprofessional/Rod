{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Listeners": [
    {
      "Name": "dev-http",
      "Transport": "Http",
      "BindAddress": "127.0.0.1:5080",
      "PublicEndpoint": "http://localhost:5080"
    }
  ],

  // Post-operation retention (roadmap M6.4): the engagement trail and its
  // artifacts persist to this directory, so they outlive a teamserver restart and
  // infrastructure teardown. The composition root swaps the in-memory audit and
  // artifact adapters for the file-backed pair when this is set. Remove the
  // section to fall back to in-memory (state is lost on restart).
  "Audit": {
    "DataDirectory": "./data/audit"
  }
}
