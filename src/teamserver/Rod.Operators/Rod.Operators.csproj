<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Rod.CoreState\Rod.CoreState.csproj" />
    <ProjectReference Include="..\Rod.Audit\Rod.Audit.csproj" />
  </ItemGroup>

  <!-- The operator layer terminates the SSE event stream and maps the operator-
       facing live endpoint: it needs ASP.NET Core (routing, HttpResponse
       streaming). A FrameworkReference avoids a long list of PackageReferences
       and tracks the runtime version centrally, the same way Rod.Transport
       does. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- The MCP server (architecture.md Sec 4, the operator layer's agent
       surface) and the OpenAI-compatible LLM client (Sec 11, triage and
       reporting). Official first-party packages: the MCP C# SDK for the
       Streamable HTTP server, Microsoft.Extensions.AI's IChatClient for the
       chat-completions shape, and the OpenAI client underneath it for the
       compatible-endpoint wire. -->
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="OpenAI" />
  </ItemGroup>

  <PropertyGroup>
  </PropertyGroup>

</Project>
