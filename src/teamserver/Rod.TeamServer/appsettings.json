{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Production implant CA (architecture.md Sec 9): an externally provisioned
  // engagement CA consumed as PEM files. Supply both paths to replace the
  // walking-skeleton self-signed DevCertificateAuthority so enrollment binds
  // certificates to the operator's CA chain; omit the section to keep the dev
  // CA. CaPrivateKeyPassphrase decrypts an encrypted PKCS#8 key -- set it via
  // an environment variable (Pki__CaPrivateKeyPassphrase) or a secret store,
  // never inline here. See ADR 0010.
  //
  // "Pki": {
  //   "CaCertificatePath": "/etc/rod/pki/ca.crt",
  //   "CaPrivateKeyPath": "/etc/rod/pki/ca.key",
  //   "CaPrivateKeyPassphrase": ""
  // },

  "Listeners": [
    {
      "Name": "dev-http",
      "Transport": "Http",
      "BindAddress": "127.0.0.1:5080",
      "PublicEndpoint": "http://localhost:5080"
    }
  ],

  // Durable teamserver state (ADR 0003): when a Postgres
  // connection string is set here, the composition root swaps the in-memory
  // core-state and audit/artifact adapters for the Postgres-backed pair in
  // Rod.Persistence, so every engagement, operator, implant, session, task, and
  // token survives a restart and the audit chain still verifies. Uncomment and
  // point at a reachable database to opt in; otherwise the in-memory adapters
  // stay registered (state is lost on restart) and the file-backed audit trail
  // below is the walking-skeleton stand-in.
  //
  // "ConnectionStrings": {
  //   "Postgres": "Host=localhost;Port=5432;Database=rod;Username=rod;Password=rod"
  // },

  // Post-operation retention: the engagement trail and its
  // artifacts persist to this directory, so they outlive a teamserver restart and
  // infrastructure teardown. The composition root swaps the in-memory audit and
  // artifact adapters for the file-backed pair when this is set. Remove the
  // section to fall back to in-memory (state is lost on restart).
  "Audit": {
    "DataDirectory": "./data/audit"
  },

  // Out-of-tree capability modules (architecture.md Sec 10.2): a list of
  // "Namespace.Type, AssemblyName" entries. Each listed type must implement
  // Rod.Tradecraft.Modules.ICapabilityModule; the assembly is resolved by name
  // (already loaded, or a same-named dll next to the teamserver binary), the
  // type is instantiated at startup, and its descriptor replaces the placeholder
  // for its verb (last registration wins) -- adding a module is a deploy-time
  // config entry, never a composition-root edit. A missing assembly or a
  // non-module type fails startup loudly rather than tasking into a placeholder.
  "Tradecraft": {
    "Modules": []
  }
}
