{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Listeners": [
    {
      "Name": "dev-http",
      "Transport": "Http",
      "BindAddress": "127.0.0.1:5080",
      "PublicEndpoint": "http://localhost:5080"
    }
  ],

  // Durable teamserver state (ADR 0003, roadmap M10.1): when a Postgres
  // connection string is set here, the composition root swaps the in-memory
  // core-state and audit/artifact adapters for the Postgres-backed pair in
  // Rod.Persistence, so every engagement, operator, implant, session, task, and
  // token survives a restart and the audit chain still verifies. Uncomment and
  // point at a reachable database to opt in; otherwise the in-memory adapters
  // stay registered (state is lost on restart) and the file-backed audit trail
  // below is the walking-skeleton stand-in.
  //
  // "ConnectionStrings": {
  //   "Postgres": "Host=localhost;Port=5432;Database=rod;Username=rod;Password=rod"
  // },

  // Post-operation retention (roadmap M6.4): the engagement trail and its
  // artifacts persist to this directory, so they outlive a teamserver restart and
  // infrastructure teardown. The composition root swaps the in-memory audit and
  // artifact adapters for the file-backed pair when this is set. Remove the
  // section to fall back to in-memory (state is lost on restart).
  "Audit": {
    "DataDirectory": "./data/audit"
  }
}
