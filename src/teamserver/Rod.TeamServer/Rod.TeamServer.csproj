<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Rod.TeamServer is the runnable teamserver process (architecture.md Sec 4) and
    the composition root: it wires Rod.Transport's services and endpoints and
    serves the operator UI (roadmap M1.5). It is not one of the six internal
    layers, and the layer dependency rules (tests/teamserver/Rod.Architecture.Tests) do not
    constrain it. As the composition root it references the layers it assembles:
    transport, and from roadmap M2.4 the operator layer, whose SSE event stream
    and live bus are wired here (transport itself cannot reference
    Rod.Operators). From M8.1 it also references Rod.Tradecraft, whose capability
    registry is wired here so the live task path resolves verbs through it
    (transport itself cannot reference Rod.Tradecraft either). From M10.1 it also
    references Rod.Persistence, whose Postgres-backed adapters swap in for the
    in-memory ports when ConnectionStrings:Postgres is set (ADR 0003).
  -->
  <ItemGroup>
    <ProjectReference Include="..\Rod.Transport\Rod.Transport.csproj" />
    <ProjectReference Include="..\Rod.Operators\Rod.Operators.csproj" />
    <ProjectReference Include="..\Rod.Tradecraft\Rod.Tradecraft.csproj" />
    <ProjectReference Include="..\Rod.Persistence\Rod.Persistence.csproj" />
  </ItemGroup>

  <!-- EF Core design-time tools resolve against the startup project (AGENTS.md
       Sec 4: `dotnet ef migrations add ... -s <Web>`), so the host carries the
       Design package as a private asset. It is never deployed and never reaches
       the runtime dependency graph. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Fresh-clone convenience: the built operator UI is gitignored, so the first
       build of this project needs Node to produce wwwroot/index.html. When the
       bundle is missing, build the SPA with npm before the .NET build packages
       it. npm is probed first so a backend-only checkout without Node still
       builds; the root route then answers with a plain explanation instead of
       a broken UI (Program.cs). -->
  <Target Name="EnsureOperatorUiBundle" BeforeTargets="Build" Condition="!Exists('wwwroot/index.html')">
    <Exec Command="npm --version" IgnoreExitCode="true" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_RodNpmProbe" />
    </Exec>
    <Exec Condition="'$(_RodNpmProbe)' == '0'" Command="npm ci &amp;&amp; npm run build" WorkingDirectory="Client" ConsoleToMSBuild="true" />
    <Message Condition="'$(_RodNpmProbe)' != '0'" Importance="high" Text="Operator UI bundle not found (wwwroot/index.html) and npm is not on PATH; the server will run API-only. Build it with npm ci &amp;&amp; npm run build in src/teamserver/Rod.TeamServer/Client." />
  </Target>

</Project>
