<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Rod.CoreState\Rod.CoreState.csproj" />
    <ProjectReference Include="..\Rod.Audit\Rod.Audit.csproj" />
  </ItemGroup>

  <!-- The composition-root hook (AddRodTradecraft) registers the capability
       registry and the registry-backed task resolver into the DI container, so
       the layer needs the DI abstractions. Kept to the abstractions (not the
       full ASP.NET Core framework reference the operator layer carries) since
       the tradecraft layer owns no HTTP surface. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
