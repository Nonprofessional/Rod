<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The reference .NET stage-2 implant. A benign, readable,
    cross-platform implant that enrolls over HTTP (submitting its own public
    key), beacons over mTLS, and runs the standard-category verb set: shell
    exec, recon, lateral (child derivation, token inspection, remote exec over
    admin channels), persistence (Run key / scheduled tasks / services / cron /
    systemd), collect (file and credential-store enumeration), and exfil to the
    engagement artifact store (architecture.md Sec 10.1). It performs no
    evasion, no obfuscation, and no destructive behavior; keyboard capture and
    LSASS dumping stay out-of-tree by the Sec 13 boundary.

    This project is an EXTERNAL component, coupled to the teamserver only by the
    wire protocol: it is intentionally NOT part of Rod.slnx. The teamserver's
    .NET build unit (DotNetBuildUnit) compiles it per build request.

    The protobuf/gRPC wire bindings are generated at build time from the
    canonical teamserver proto (src/teamserver/Rod.Protocol/protos/rod.proto) via Grpc.Tools.
    No generated code is committed; rod.proto is the single source of truth, the
    same contract every Rod implant of every language builds against.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      Directory.Build.props at the repo root sets the shared build settings
      (TargetFramework, Nullable, ImplicitUsings, TreatWarningsAsErrors, latest
      LangVersion) repo-wide and applies to this tree (it walks up from the
      project dir). The implant adopts the same discipline as the teamserver.
      CPM is on repo-wide and the implant's package versions are governed
      centrally by Directory.Packages.props.
    -->
    <AssemblyName>Rod.Implant</AssemblyName>
    <RootNamespace>Rod.Implant</RootNamespace>
    <!--
      The generated gRPC surface, the compile half of the bake-time transport
      trim (architecture.md Sec 8): "Client" (the default) also generates the
      Beacon.Contact gRPC client the mTLS stream module dials; "None" (what
      the build unit passes for a walk with no stream-shaped entry) generates
      the rod.v1 message types only. The Grpc.Net.Client reference rides the
      same switch below, so a web-shaped build links no gRPC client code at
      all. Dev builds of the checked-in tree keep the full client.
    -->
    <RodGrpcServices Condition="'$(RodGrpcServices)' == ''">Client</RodGrpcServices>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The wire protocol contract. The proto is the teamserver's
      (src/teamserver/Rod.Protocol/protos/rod.proto); the Link keeps it visible
      under protos/ in the implant project without copying it. Client-only: the
      implant dials the Beacon.Contact stream; it does not host any service.
      The gRPC services generated alongside the messages follow the
      RodGrpcServices trim switch above. rod.proto has no imports, so no
      ProtoRoot is needed; Grpc.Tools compiles the single file directly.
    -->
    <Protobuf
      Include="..\..\teamserver\Rod.Protocol\protos\rod.proto"
      Link="protos\rod.proto"
      GrpcServices="$(RodGrpcServices)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Versions are governed centrally by Directory.Packages.props at the repo
         root (CPM), so no Version is set here. Google.Protobuf and Grpc.Tools
         stay in every shape: the messages (and their generation) are the wire
         contract both check-in clients speak. -->
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" Condition="'$(RodGrpcServices)' != 'None'" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The internal handler types (HandlerRegistry, Core, Collect, Exfil,
         Persist, Lateral) and the internal pure parse/chunk helpers are
         visible to the external xUnit test project (tests/implant/dotnet), the
         .NET equivalent of the Go reference implant's same-package _test.go
         access. -->
    <InternalsVisibleTo Include="Rod.Implant.Tests" />
  </ItemGroup>

</Project>
