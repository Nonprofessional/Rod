<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Rod.CoreState\Rod.CoreState.csproj" />
    <!-- Rod.Protocol is the language-neutral wire contract (architecture.md
         Sec.8/9); the transport layer speaks it, mapping enrollment and other
         outcomes to wire status codes. Protocol itself depends on nothing
         in-house, and still never leaks into core state. -->
    <ProjectReference Include="..\Rod.Protocol\Rod.Protocol.csproj" />
  </ItemGroup>

  <!-- The transport layer terminates C2 endpoints and the operator API: it needs
       ASP.NET Core (Kestrel, routing, JSON). A FrameworkReference avoids a long
       list of PackageReferences and tracks the runtime version centrally. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- gRPC server: terminates the implant-initiated beacon stream (M1.3). The
       wire contract (services/messages) is generated in Rod.Protocol; this
       package binds those server stubs to ASP.NET Core endpoint routing. -->
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
