<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Live Postgres for the durability acceptance test (ADR 0003). An
         ephemeral container per test class; tests skip (not fail)
         when Docker is unavailable, so CI without Docker stays green. -->
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- Direct reference forces the transitive SSH.NET (pulled by
         Testcontainers) up to the central version in Directory.Packages.props,
         above the vulnerable 2025.1.0 (GHSA-q939-rpr3-3284). -->
    <PackageReference Include="SSH.NET" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Serialized collections (xunit.runner.json): the assembly kept losing
         its completion signal on CI, with every test green, no thread running
         anything, and the runner waiting forever (Sep 1 hang dumps; the same
         shape burned six-hour budgets in August). Parallel collection
         scheduling is where v2 loses runs, so the assembly takes the
         wall-time hit instead. The structural fix is the xUnit v3 +
         Microsoft Testing Platform migration. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\teamserver\Rod.Transport\Rod.Transport.csproj" />
    <!-- Referenced so the operator layer (live bus + SSE endpoint) can be
         layered into the test host alongside the transport core. -->
    <ProjectReference Include="..\..\..\src\teamserver\Rod.Operators\Rod.Operators.csproj" />
    <!-- Referenced so the tradecraft layer (capability registry wired onto
         the live task path) can be layered into the test host alongside the
         transport core. -->
    <ProjectReference Include="..\..\..\src\teamserver\Rod.Tradecraft\Rod.Tradecraft.csproj" />
    <!-- Referenced so the durable PostgreSQL store (Postgres-backed
         operators and engagements) can be layered into the test host and the
         durability acceptance test can resolve its DbContext directly. -->
    <ProjectReference Include="..\..\..\src\teamserver\Rod.Persistence\Rod.Persistence.csproj" />
    <!-- Referenced so the composition root's own surface is testable: the
         build-stamp endpoint (GET /build) lives in the executable because the
         stamp is a property of the binary, not of any layer. -->
    <ProjectReference Include="..\..\..\src\teamserver\Rod.TeamServer\Rod.TeamServer.csproj" />
  </ItemGroup>

</Project>
