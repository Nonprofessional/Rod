<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Live Postgres for the durability acceptance test (ADR 0003, roadmap
         M10.1). An ephemeral container per test class; tests skip (not fail)
         when Docker is unavailable, so CI without Docker stays green. -->
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\teamserver\Rod.Transport\Rod.Transport.csproj" />
    <!-- Referenced so the operator layer (M2.4: live bus + SSE endpoint) can be
         layered into the test host alongside the transport core. -->
    <ProjectReference Include="..\..\..\src\teamserver\Rod.Operators\Rod.Operators.csproj" />
    <!-- Referenced so the tradecraft layer (M8.1: capability registry wired onto
         the live task path) can be layered into the test host alongside the
         transport core. -->
    <ProjectReference Include="..\..\..\src\teamserver\Rod.Tradecraft\Rod.Tradecraft.csproj" />
    <!-- Referenced so the durable PostgreSQL store (M10.1: Postgres-backed
         operators and engagements) can be layered into the test host and the
         durability acceptance test can resolve its DbContext directly. -->
    <ProjectReference Include="..\..\..\src\teamserver\Rod.Persistence\Rod.Persistence.csproj" />
  </ItemGroup>

</Project>
