<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The xUnit unit tests for the reference .NET implant (roadmap M3.3, ADR 0009).
    Like the implant itself, this project is an EXTERNAL component: it is
    intentionally NOT part of Rod.slnx, mirroring how the Go reference implant's
    _test.go files lived in the implant's own module. CI runs it explicitly
    (`dotnet test implant-dotnet-tests/Rod.Implant.Tests.csproj`).

    The implant's internal handler types (Runner, Collect, Exfil, Persist,
    Lateral) and its internal pure parse/chunk helpers are visible to this
    assembly via InternalsVisibleTo in Rod.Implant.csproj, the .NET equivalent
    of the Go reference implant's same-package _test.go access. The wire types
    (TaskOutcome, ExfilChunk, TransportProfile) are public, generated by the
    implant's gRPC client build.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!--
      Directory.Build.props at the repo root already sets Nullable,
      TreatWarningsAsErrors, and the latest LangVersion repo-wide, and applies to
      this tree (it walks up from the project dir). CPM is on repo-wide and the
      test package versions are governed centrally by Directory.Packages.props.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <!-- References the implant so the tests reach its internal handler types and
       the public wire types its gRPC client build generates. -->
  <ItemGroup>
    <ProjectReference Include="..\implant-dotnet\Rod.Implant.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
